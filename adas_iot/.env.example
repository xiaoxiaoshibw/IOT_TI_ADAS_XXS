# ADAS IoT Platform 配置环境变量
# ==============================
# 复制为 .env 并修改

# MQTT Broker
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=adas/v1

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000

# Jetson Orin
ORIN_IP=192.168.100.32
ORIN_USER=jetson
ORIN_ROS_WS=~/adas/adas_soc_ws

# Simulator
SIM_ENABLED=true
SIM_INITIAL_SPEED=15.0
SIM_MAX_SPEED=30.0
SIM_FAULT_INJECTION=true
SIM_FAULT_INTERVAL=30

# CAN
CAN_INTERFACE=can1
CAN_BITRATE=500000
