.settings-page {
  padding-bottom: 40rpx;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #465e61;
  font-size: 25rpx;
  font-weight: 700;
}

.text-input {
  width: 100%;
  height: 86rpx;
  padding: 0 22rpx;
  background: #f8fbfc;
  border: 1rpx solid #dbe4e6;
  border-radius: 8rpx;
  color: #203638;
  font-size: 26rpx;
}

.readonly {
  min-height: 76rpx;
  padding: 18rpx 20rpx;
  background: #f1f5f6;
  border-radius: 8rpx;
  color: #607174;
  font-size: 24rpx;
  line-height: 34rpx;
  word-break: break-all;
}

.test-button {
  margin-top: 24rpx;
}

.warn-banner {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  background: #fef3c7;
  border: 1rpx solid #fde68a;
  border-radius: 8rpx;
  color: #92400e;
  font-size: 24rpx;
  line-height: 36rpx;
}

.hint {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  background: #ecfeff;
  border: 1rpx solid #a5f3fc;
  border-radius: 8rpx;
  color: #155e75;
  font-size: 24rpx;
  line-height: 40rpx;
}

.kbd {
  padding: 2rpx 8rpx;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  border-radius: 6rpx;
  color: #0f172a;
  font-family: "SF Mono", Consolas, monospace;
  font-size: 22rpx;
  word-break: break-all;
}

.debug-info {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  background: #f1f5f6;
  border-radius: 8rpx;
}

.debug-row {
  margin-top: 8rpx;
  color: #41585b;
  font-size: 24rpx;
  line-height: 36rpx;
}

.debug-row:first-child {
  margin-top: 0;
}

.debug-row-list {
  margin-top: 14rpx;
}

.debug-item {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.debug-copy {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  background: #0f766e;
  border-radius: 6rpx;
  color: #ffffff;
  font-size: 22rpx;
}

.debug-empty {
  margin-top: 8rpx;
  color: #718184;
  font-size: 23rpx;
}

.debug-error {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  background: #fee2e2;
  border: 1rpx solid #fca5a5;
  border-radius: 8rpx;
  color: #991b1b;
  font-size: 24rpx;
  line-height: 34rpx;
}

.action-row {
  margin-top: 24rpx;
  display: flex;
}

.action-button {
  width: 50%;
}

.action-button:first-child {
  margin-right: 12rpx;
}

.action-button:last-child {
  margin-left: 12rpx;
}