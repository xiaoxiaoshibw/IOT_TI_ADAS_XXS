<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adas_carla_bridge</name>
  <version>0.0.2</version>
  <description>CARLA ↔ ADAS SoC 栈 ROS2 桥：CARLA 真值发布为 /adas/* 感知话题，回收执行量驱动 CARLA 自车（IOT_TI HIL 闭环 PC 端）</description>
  <maintainer email="dev@adas.local">adas</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-can</exec_depend>
  <exec_depend>python3-usb</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <depend>adas_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
