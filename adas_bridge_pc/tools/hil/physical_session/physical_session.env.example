# Phase 4 物理会话 env 占位模板
#
# 用法（bench 现场）：
#   1) 复制本文件：cp physical_session.env.example physical_session.env.template.work
#   2) 替换所有 <PLACEHOLDER>；不要替换 ${RUN_ID} / ${SESSION_DIR} 占位 —— 那两个
#      留给下游 envsubst 注入（runner 不会再做 shell 展开）。
#   3) envsubst < physical_session.env.template.work > physical_session.env
#   4) set -a; source physical_session.env; set +a
#   5) 启动物理会话
#
# 关于 MANUAL_ONLY step：fault_bad_crc_firmware / fault_sequence_corruption 由现场监督人
# 人工执行，runner 不调用命令，对应行保持未设置 / 注释即可。
#
# 关于凭据：本文件**禁止**写入密码、sudo 密码、SSH 私钥路径、API token。如需凭据
# 必须从受控文件中读取或由 SSH agent 提供。

# ---------------------------------------------------------------------------
# session 上下文（runner 自身从 CLI --run-id / --session-dir 注入；这里只为命令预备）
# ---------------------------------------------------------------------------
export PHYSICAL_RUN_ID="${PHYSICAL_RUN_ID}"          # runner / launcher 注入
export PHYSICAL_SESSION_DIR="${PHYSICAL_SESSION_DIR}" # runner / launcher 注入

# ---------------------------------------------------------------------------
# 4.0 D-1 pre_session_checklist
# ---------------------------------------------------------------------------
# 期望：argv[0] = <PREFLIGHT_HELPER>；副作用仅本机读；退出 0=PASS
export PHYSICAL_PRE_SESSION_CHECKLIST_COMMAND='<PREFLIGHT_HELPER> --run-id "${RUN_ID}" --session-dir "${SESSION_DIR}" --write-to "${SESSION_DIR}/preflight.local"'

# ---------------------------------------------------------------------------
# 4.1.2 orin_service_readiness
# ---------------------------------------------------------------------------
# 期望：SSH 命令，BatchMode=yes / ConnectTimeout=5；stdout 期望 "active"
export PHYSICAL_ORIN_SERVICE_READINESS_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new <USER>@<JETSON_HOST> systemctl is-active adas-hil.service'

# ---------------------------------------------------------------------------
# 4.1.3 mcu_session_handshake
# ---------------------------------------------------------------------------
# 期望：candump 包装工具；写出 can1_session.log；退出 0=PASS
export PHYSICAL_MCU_SESSION_HANDSHAKE_COMMAND='<BENCH_CAPTURE_BIN> --run-id "${RUN_ID}" --session-dir "${SESSION_DIR}" --iface can1 --timeout 30'

# ---------------------------------------------------------------------------
# 4.2.1 / 4.2.2 / 4.2.3 actuator_{drive,steer,brake}_check
# ---------------------------------------------------------------------------
# 期望：MCU closed loop 下因果捕获；退出 0=PASS，1=帧缺失，2=超时部分采样
export PHYSICAL_ACTUATOR_DRIVE_CHECK_COMMAND='<ACTUATOR_PROBE_BIN> --axis drive --run-id "${RUN_ID}" --session-dir "${SESSION_DIR}" --timeout 75'
export PHYSICAL_ACTUATOR_STEER_CHECK_COMMAND='<ACTUATOR_PROBE_BIN> --axis steer --run-id "${RUN_ID}" --session-dir "${SESSION_DIR}" --timeout 75'
export PHYSICAL_ACTUATOR_BRAKE_CHECK_COMMAND='<ACTUATOR_PROBE_BIN> --axis brake --run-id "${RUN_ID}" --session-dir "${SESSION_DIR}" --timeout 75'

# ---------------------------------------------------------------------------
# 4.2.4 feedback_freshness_check
# ---------------------------------------------------------------------------
# 期望：rate_hz / max_age_ms / sequence_gaps 三行；只读 ROS / CAN
export PHYSICAL_FEEDBACK_FRESHNESS_CHECK_COMMAND='<FEEDBACK_PROBE_BIN> --topic "<FEEDBACK_TOPIC>" --window 5s'

# ---------------------------------------------------------------------------
# 4.3.1 fault_mcu_power_off
# ---------------------------------------------------------------------------
# 期望：仅对 MCU 主供电切断；波及 jetson / 全局电源的命令**禁止**
export PHYSICAL_FAULT_MCU_POWER_OFF_COMMAND='<POWER_CTRL_BIN> --action power-off --target mcu-main --run-id "${RUN_ID}" --session-dir "${SESSION_DIR}" --duration-ms 200'

# ---------------------------------------------------------------------------
# 4.3.2 fault_can_disconnect
# ---------------------------------------------------------------------------
# 期望：仅 down can1；不可波及 can0 / eth0 / wlan0
export PHYSICAL_FAULT_CAN_DISCONNECT_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=5 <USER>@<JETSON_HOST> sudo -n ip link set can1 down'

# ---------------------------------------------------------------------------
# 4.3.3 / 4.3.4 MANUAL_ONLY —— 保持未 export；如需登记操作员口头指令可在此注释
# ---------------------------------------------------------------------------
# export PHYSICAL_FAULT_BAD_CRC_FIRMWARE_COMMAND=          # runner 不读
# export PHYSICAL_FAULT_SEQUENCE_CORRUPTION_COMMAND=       # runner 不读

# ---------------------------------------------------------------------------
# 4.3.5 service_restart
# ---------------------------------------------------------------------------
# 期望：仅影响 adas-hil.service；sudo -n 必须 NOPASSWD
export PHYSICAL_SERVICE_RESTART_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=5 <USER>@<JETSON_HOST> sudo -n systemctl restart adas-hil.service'

# ---------------------------------------------------------------------------
# 4.4.1 long_run_stability
# ---------------------------------------------------------------------------
# 期望：30 分钟长稳；latches=0、run_id_drift=0
export PHYSICAL_LONG_RUN_STABILITY_COMMAND='hil_logger --duration 30m --topic "/adas/vehicle/actuation_cmd" --rate-min 100 --session-dir "${SESSION_DIR}"'

# ---------------------------------------------------------------------------
# 4.4.2 service_stop_start_round_trip
# ---------------------------------------------------------------------------
# 期望：仅 adas-hil.service 一轮 stop+start；run_id 不漂移
export PHYSICAL_SERVICE_STOP_START_ROUND_TRIP_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=5 <USER>@<JETSON_HOST> sudo -n bash -c "systemctl stop adas-hil.service && sleep 5 && systemctl start adas-hil.service && systemctl is-active adas-hil.service"'

# ---------------------------------------------------------------------------
# 4.4.3 pc_carla_restart_round_trip
# ---------------------------------------------------------------------------
# 期望：仅 PC 端 CARLA + bridge 重启；走 start_pc_stack_clean.sh 自身两阶段退出，
# 绝不显式 `kill -9`
export PHYSICAL_PC_CARLA_RESTART_ROUND_TRIP_COMMAND='bash <SCRIPT_PATH> --clean-restart --run-id "${RUN_ID}" --session-dir "${SESSION_DIR}" --wait 30'
